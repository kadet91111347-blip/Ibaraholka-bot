# === Обязательные ===
BOT_TOKEN=           # от @BotFather
WEBAPP_URL=          # https://your-domain (БЕЗ /mini в конце)
CHANNEL_ID=          # @ibaraholkatyt (для публикации)
DATABASE_URL=        # postgresql://ibaraholka:PASS@127.0.0.1:5432/ibaraholka
ADMIN_IDS=           # 748834052 (твой uid через запятую)
ADMIN_TOKEN=         # любой длинный случайный

# === Mini App URL ===
# после setup.sh заменить в .env на свой домен

# === Опциональные платежи ===
TINKOFF_TERMINAL=
TINKOFF_PASSWORD=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET=
TON_WALLET=
TON_API_KEY=
DEMO_MODE=0

# === Sentry/Logs ===
SENTRY_DSN=
LOG_LEVEL=INFO
